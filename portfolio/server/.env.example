# Copy this file to .env and fill in the values. NEVER commit .env.

PORT=5000
# Comma-separated list of allowed website origins (the deployed frontend URL).
CLIENT_ORIGIN=http://localhost:5173

# ---- Chatbot (RAG) ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Use "gemini" for real embeddings, or "local" for an offline hashing embedder (no key needed).
EMBED_PROVIDER=gemini
# Minimum cosine similarity for a chunk to count as relevant. Lower = more permissive.
# Leave empty to use the default for the provider.
MIN_SCORE=

# Optional: use any OpenAI-compatible LLM instead of Gemini (Groq, OpenAI, OpenRouter...).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# ---- Contact form email (SMTP) ----
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where visitor messages are delivered.
CONTACT_TO=
# Alternative to SMTP: Brevo HTTPS API key (starts with xkeysib-). If set, it is used instead of SMTP.
BREVO_API_KEY=
# Sender address shown on the email. Needed for Brevo (must be a verified sender). Defaults to SMTP_USER.
MAIL_FROM=
# true = do not send, just log (useful before you add SMTP credentials)
MAIL_DRY_RUN=false
